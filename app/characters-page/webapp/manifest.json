{
  "_version": "1.84.0",
  "sap.app": {
    "id": "characterspage",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.24.0",
      "toolsId": "82799944-f2a4-4fb9-973d-c889aeaa1d3e"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/dino/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {}
      }
    },
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "characterspage.i18n.i18n",
          "supportedLocales": [
            "en",
            "ja"
          ],
          "fallbackLocale": "en"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "characterspage.i18n.i18n",
          "supportedLocales": [
            "en",
            "ja"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CharactersList",
          "target": "CharactersList"
        },
        {
          "pattern": "Characters({key}):?query:",
          "name": "CharactersObjectPage",
          "target": "CharactersObjectPage"
        }
      ],
      "targets": {
        "CharactersList": {
          "type": "Component",
          "id": "CharactersList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Characters",
              "variantManagement": "Page",
              "navigation": {
                "Characters": {
                  "detail": {
                    "route": "CharactersObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "CharactersObjectPage": {
          "type": "Component",
          "id": "CharactersObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Characters",
              "content": {
                "header": {
                  "actions": {
                    "CharactersController": {
                      "press": "characterspage.ext.controller.CharactersController.onUploadButtonPressed",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{{uploadImages}}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
