{
  "name": "dino-game-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.2.1",
    "@types/node": "^26.6.6",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-characters-page": "cds watch --open characterspage/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build:ui": "npm run build --workspaces --if-present",
    "build:cds": "npm exec -- cds build --production",
    "build": "npm run build:cds && npm run build:ui",
    "dev": "cds watch",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "watch-game": "cds watch --open game/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/characters-page",
    "app/game"
  ]
}
